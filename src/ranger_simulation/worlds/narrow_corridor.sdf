<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="narrow_corridor">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors"><render_engine>ogre</render_engine></plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link></model>
    
    <!-- S-Curve Narrow Corridor (1.2m width) -->
    <model name="wall_left_1"><static>true</static><pose>-0.6 5 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 10 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 2</size></box></geometry></visual></link></model>
    <model name="wall_right_1"><static>true</static><pose>0.6 3 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 6 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 6 2</size></box></geometry></visual></link></model>
    <model name="wall_turn_top"><static>true</static><pose>2.0 6.1 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>3.0 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>3.0 0.2 2</size></box></geometry></visual></link></model>
    <model name="wall_turn_bottom"><static>true</static><pose>2.0 4.9 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>3.0 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>3.0 0.2 2</size></box></geometry></visual></link></model>
    <model name="wall_left_2"><static>true</static><pose>3.6 1.9 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 6 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 6 2</size></box></geometry></visual></link></model>
    <model name="wall_right_2"><static>true</static><pose>4.8 3.9 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 6 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 6 2</size></box></geometry></visual></link></model>
  </world>
</sdf>
