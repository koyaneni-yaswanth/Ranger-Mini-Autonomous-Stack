<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="workstation_manipulation">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors"><render_engine>ogre</render_engine></plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link></model>

    <!-- Inspection Workstation Table (at x=1.6, y=0.0) -->
    <model name="workstation_table">
      <static>true</static>
      <pose>1.6 0.0 0.15 0 0 0</pose>
      <link name="table_top">
        <collision name="c"><geometry><box><size>0.8 1.2 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 1.2 0.3</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Manipulation Pick Target: Small industrial cube on the table -->
    <model name="target_cube_red">
      <pose>1.45 0.0 0.33 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.15</mass><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
        <collision name="c"><geometry><box><size>0.05 0.05 0.06</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.06</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Drop Bin for Placed Objects (at x=1.6, y=-0.8) -->
    <model name="drop_bin">
      <static>true</static>
      <pose>1.6 -0.8 0.15 0 0 0</pose>
      <link name="bin_link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.3</size></box></geometry><material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
