<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="obstacle_rich">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors"><render_engine>ogre</render_engine></plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link></model>

    <!-- Perimeter Boundary 16m x 16m -->
    <model name="wall_n"><static>true</static><pose>0 8 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>16.2 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>16.2 0.2 2</size></box></geometry></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -8 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>16.2 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>16.2 0.2 2</size></box></geometry></visual></link></model>
    <model name="wall_e"><static>true</static><pose>8 0 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 16.0 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 16.0 2</size></box></geometry></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-8 0 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 16.0 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 16.0 2</size></box></geometry></visual></link></model>

    <!-- Dense Clutter Grid -->
    <model name="barrel_1"><static>true</static><pose>2.0 1.5 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="barrel_2"><static>true</static><pose>2.5 3.5 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="box_stack_1"><static>true</static><pose>0.0 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.8 1.2 1.2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.8 1.2 1.2</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name="pallet_obstacle_1"><static>true</static><pose>-2.5 1.0 0.4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 0.8 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 0.8 0.8</size></box></geometry><material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material></visual></link></model>
    <model name="pillar_mid"><static>true</static><pose>-1.0 -2.5 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry><material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material></visual></link></model>
    <model name="crate_2"><static>true</static><pose>3.0 -2.0 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
  </world>
</sdf>
