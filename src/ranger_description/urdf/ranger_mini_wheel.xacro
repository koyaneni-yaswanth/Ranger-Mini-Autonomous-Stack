<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find ranger_description)/urdf/common_macros.xacro"/>

  <!-- Macro for a single wheel assembly (steering column + rolling wheel) -->
  <xacro:macro name="ranger_mini_wheel" params="prefix offset_x offset_y offset_z steering_yaw wheel_yaw">
    
    <!-- Steering Link -->
    <link name="${prefix}_steering_link">
      <visual>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.1"/>
        </geometry>
        <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.1"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="2.0" r="0.05" h="0.1"/>
    </link>

    <!-- Steering Joint -->
    <joint name="${prefix}_steering_joint" type="revolute">
      <origin xyz="${offset_x} ${offset_y} ${offset_z}" rpy="0 0 ${steering_yaw}" />
      <parent link="base_link" />
      <child link="${prefix}_steering_link" />
      <axis xyz="0 0 1" />
      <!-- High torque capacity for heavy lifting -->
      <limit lower="-1.5707" upper="1.5707" effort="100.0" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Wheel Link -->
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 -0.005" rpy="1.57 0 0"/>
        <geometry>
          <cylinder radius="0.09" length="0.08"/>
        </geometry>
        <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.005" rpy="1.57 0 0"/>
        <geometry>
          <cylinder radius="0.09" length="0.08"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="8.0" r="0.09" h="0.08"/>
    </link>

    <!-- Wheel Joint -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="0 0 -0.1" rpy="0 0 ${wheel_yaw}" />
      <parent link="${prefix}_steering_link" />
      <child link="${prefix}_wheel_link" />
      <axis xyz="0 1 0" />
      <limit effort="50.0" velocity="10.0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <gazebo reference="${prefix}_steering_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

  </xacro:macro>

</robot>
