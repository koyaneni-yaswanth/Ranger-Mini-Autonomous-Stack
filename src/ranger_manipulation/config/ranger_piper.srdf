<?xml version="1.0" encoding="UTF-8"?>
<robot name="ranger_mini">
    <!-- GROUPS -->
    <group name="piper_arm">
        <joint name="piper_mount_joint"/>
        <joint name="piper_joint1"/>
        <joint name="piper_joint2"/>
        <joint name="piper_joint3"/>
        <joint name="piper_joint4"/>
        <joint name="piper_joint5"/>
        <joint name="piper_joint6"/>
    </group>
    
    <group name="piper_gripper">
        <link name="piper_gripper_base"/>
        <link name="piper_finger_left"/>
        <link name="piper_finger_right"/>
        <joint name="piper_finger_left_joint"/>
        <joint name="piper_finger_right_joint"/>
    </group>

    <!-- GROUP STATES -->
    <group_state name="home" group="piper_arm">
        <joint name="piper_joint1" value="0"/>
        <joint name="piper_joint2" value="0"/>
        <joint name="piper_joint3" value="0"/>
        <joint name="piper_joint4" value="0"/>
        <joint name="piper_joint5" value="0"/>
        <joint name="piper_joint6" value="0"/>
    </group_state>

    <group_state name="ready" group="piper_arm">
        <joint name="piper_joint1" value="0"/>
        <joint name="piper_joint2" value="-0.785"/>
        <joint name="piper_joint3" value="1.57"/>
        <joint name="piper_joint4" value="0"/>
        <joint name="piper_joint5" value="-0.785"/>
        <joint name="piper_joint6" value="0"/>
    </group_state>

    <group_state name="open" group="piper_gripper">
        <joint name="piper_finger_left_joint" value="0.03"/>
    </group_state>
    <group_state name="close" group="piper_gripper">
        <joint name="piper_finger_left_joint" value="0.0"/>
    </group_state>

    <!-- END EFFECTOR -->
    <end_effector name="gripper" parent_link="piper_link6" group="piper_gripper"/>

    <!-- DISABLE COLLISIONS -->
    <disable_collisions link1="base_link" link2="top_deck_link" reason="Adjacent"/>
    <disable_collisions link1="top_deck_link" link2="piper_mount" reason="Adjacent"/>
    <disable_collisions link1="piper_mount" link2="piper_link1" reason="Adjacent"/>
    <disable_collisions link1="piper_link1" link2="piper_link2" reason="Adjacent"/>
    <disable_collisions link1="piper_link2" link2="piper_link3" reason="Adjacent"/>
    <disable_collisions link1="piper_link3" link2="piper_link4" reason="Adjacent"/>
    <disable_collisions link1="piper_link4" link2="piper_link5" reason="Adjacent"/>
    <disable_collisions link1="piper_link5" link2="piper_link6" reason="Adjacent"/>
    <disable_collisions link1="piper_link6" link2="piper_gripper_base" reason="Adjacent"/>
    <disable_collisions link1="piper_gripper_base" link2="piper_finger_left" reason="Adjacent"/>
    <disable_collisions link1="piper_gripper_base" link2="piper_finger_right" reason="Adjacent"/>
    <disable_collisions link1="piper_finger_left" link2="piper_finger_right" reason="Never"/>
</robot>
