<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="red_cube_world">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Ambient Lighting and Directional Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane with high friction for 4WIS traction -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inspection Workstation Table (at x=1.6, y=0.0, height=0.3m) -->
    <model name="workstation_table">
      <static>true</static>
      <pose>1.6 0.0 0.15 0 0 0</pose>
      <link name="table_top">
        <collision name="c">
          <geometry>
            <box><size>0.8 1.2 0.3</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry>
            <box><size>0.8 1.2 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Physical Manipulation Pick Target: Bright Red Industrial Cube -->
    <model name="target_cube_red">
      <pose>1.45 0.0 0.33 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>
      <link name="cube_link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry>
            <box><size>0.05 0.05 0.06</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry>
            <box><size>0.05 0.05 0.06</size></box>
          </geometry>
          <material>
            <ambient>0.95 0.05 0.05 1</ambient>
            <diffuse>0.95 0.05 0.05 1</diffuse>
            <emissive>0.2 0.0 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Storage Rack / Environmental Obstacle (at x=1.2, y=1.2) -->
    <model name="storage_rack">
      <static>true</static>
      <pose>1.2 1.2 0.5 0 0 0</pose>
      <link name="rack_link">
        <collision name="c">
          <geometry>
            <box><size>0.6 1.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box><size>0.6 1.0 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drop Bin / Placement Station (at x=1.6, y=-0.8) -->
    <model name="drop_bin">
      <static>true</static>
      <pose>1.6 -0.8 0.15 0 0 0</pose>
      <link name="bin_link">
        <collision name="c">
          <geometry>
            <box><size>0.5 0.5 0.3</size></box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box><size>0.5 0.5 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.8 1</ambient>
            <diffuse>0.1 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Automated Charging Station (at x=0.0, y=-1.5) -->
    <model name="charging_dock">
      <static>true</static>
      <pose>0.0 -1.5 0.1 0 0 0</pose>
      <link name="dock_link">
        <collision name="c">
          <geometry>
            <box><size>0.4 0.4 0.2</size></box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box><size>0.4 0.4 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
