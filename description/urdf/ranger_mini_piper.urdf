    </collision>
    <inertial>
      <mass value="3.5"/>
      <origin rpy="0 0 0" xyz="0 0 0.0075"/>
      <inertia ixx="0.034" ixy="0.0" ixz="0.0" iyy="0.085" iyz="0.0" izz="0.118"/>
    </inertial>
  </link>
  <joint name="top_deck_joint" type="fixed">
    <parent link="body_enclosure_link"/>
    <child link="top_deck_link"/>
    <!-- Sits exactly on top of the enclosure at z = 0.16m -->
    <origin rpy="0 0 0" xyz="0 0 0.16"/>
  </joint>
  <!-- Universal Manipulator Mounting Pedestal (Reinforced ISO Flange) -->
  <link name="manipulator_mount">
    <!-- Reinforced Circular Mounting Flange -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0075"/>
      <geometry>
        <cylinder length="0.015" radius="0.085"/>
      </geometry>
      <material name="machined_steel">
        <color rgba="0.65 0.67 0.70 1.0"/>
      </material>
    </visual>
    <!-- Base Structural Riser / Internal Gusset Interface -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.002"/>
      <geometry>
        <box size="0.14 0.14 0.004"/>
      </geometry>
      <material name="anodized_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <!-- Visual Bolt Pattern (4x M5 Fasteners on 60x60mm pattern) -->
    <visual>
      <origin rpy="0 0 0" xyz="0.03 0.03 0.016"/>
      <geometry>
        <cylinder length="0.003" radius="0.005"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.03 -0.03 0.016"/>
      <geometry>
        <cylinder length="0.003" radius="0.005"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.03 0.03 0.016"/>
      <geometry>
        <cylinder length="0.003" radius="0.005"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.03 -0.03 0.016"/>
      <geometry>
        <cylinder length="0.003" radius="0.005"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <!-- Collision Envelope -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0075"/>
      <geometry>
        <cylinder length="0.015" radius="0.085"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <origin rpy="0 0 0" xyz="0 0 0.0075"/>
      <inertia ixx="0.0022" ixy="0.0" ixz="0.0" iyy="0.0022" iyz="0.0" izz="0.0043"/>
    </inertial>
  </link>
  <joint name="manipulator_mount_joint" type="fixed">
    <parent link="top_deck_link"/>
    <child link="manipulator_mount"/>
    <!-- Standardized forward mounting position on top deck -->
    <origin rpy="0 0 0" xyz="0.15 0 0.015"/>
  </joint>
  <!-- Elevated Sensor Mast (Extruded Aluminum Dual-Column Structure) -->
  <link name="sensor_mast_link">
    <!-- Main Mast Column -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.175"/>
      <geometry>
        <box size="0.06 0.10 0.35"/>
      </geometry>
      <material name="industrial_charcoal">
        <color rgba="0.15 0.17 0.20 1.0"/>
      </material>
    </visual>
    <!-- Base Deck Anchor Plate -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.003"/>
      <geometry>
        <box size="0.10 0.14 0.006"/>
      </geometry>
      <material name="anodized_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>
    <!-- Top LiDAR Mounting Platform Plate -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.352"/>
      <geometry>
        <box size="0.10 0.12 0.008"/>
      </geometry>
      <material name="anodized_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>
    <!-- Forward Camera Mounting Bracket -->
    <visual>
      <origin rpy="0 0.2618 0" xyz="0.035 0 0.24"/>
      <geometry>
        <box size="0.03 0.08 0.02"/>
      </geometry>
      <material name="anodized_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <!-- Collision Envelope for Mast Structure -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.175"/>
      <geometry>
        <box size="0.08 0.12 0.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <origin rpy="0 0 0" xyz="0 0 0.175"/>
      <inertia ixx="0.013" ixy="0.0" ixz="0.0" iyy="0.013" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="sensor_mast_joint" type="fixed">
    <parent link="top_deck_link"/>
    <child link="sensor_mast_link"/>
    <!-- Mounted on rear center of top deck -->
    <origin rpy="0 0 0" xyz="-0.16 0.0 0.015"/>
  </joint>
  <!-- Livox Mid-360 3D LiDAR (Elevated on top of mast, 360 deg clear FOV) -->
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <cylinder length="0.045" radius="0.038"/>
      </geometry>
      <material name="matte_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <!-- Optical Window Band -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <cylinder length="0.015" radius="0.039"/>
      </geometry>
      <material name="optical_glass">
        <color rgba="0.2 0.4 0.6 0.8"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <cylinder length="0.05" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.265"/>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <inertia ixx="0.00015" ixy="0.0" ixz="0.0" iyy="0.00015" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="lidar_link"/>
    <!-- Sits on top of the mast platform (z=0.356m relative to mast base) -->
    <origin rpy="0 0 0" xyz="0.0 0.0 0.356"/>
  </joint>
  <!-- Intel RealSense D435i RGB-D Camera (Mounted on mast, tilted 15 deg forward) -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.01 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="realsense_silver">
        <color rgba="0.75 0.77 0.80 1.0"/>
      </material>
    </visual>
    <!-- Dual Stereo Infrared Emitter/Receiver Visuals -->
    <visual>
      <origin rpy="0 1.5707963 0" xyz="0.023 0.025 0"/>
      <geometry>
        <cylinder length="0.002" radius="0.006"/>
      </geometry>
      <material name="matte_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 1.5707963 0" xyz="0.023 -0.025 0"/>
      <geometry>
        <cylinder length="0.002" radius="0.006"/>
      </geometry>
      <material name="matte_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.01 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin rpy="0 0 0" xyz="0.01 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="camera_link"/>
    <!-- Mounted forward at z=0.24m on mast, tilted 15 deg (0.2618 rad) forward-down -->
    <origin rpy="0 0.2618 0" xyz="0.045 0.0 0.24"/>
  </joint>
  <!-- Camera Optical Frame (ROS Standard: Z forward, X right, Y down) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="-1.5707963 0 -1.5707963" xyz="0 0 0"/>
  </joint>
  <!-- Physical Emergency Stop Button (Mounted on upper deck rear panel) -->
  <link name="estop_button_link">
    <!-- Safety Yellow Bezel -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.005"/>
      <geometry>
        <cylinder length="0.010" radius="0.020"/>
      </geometry>
      <material name="safety_yellow">
        <color rgba="0.95 0.80 0.10 1.0"/>
      </material>
    </visual>
    <!-- Red Mushroom Palm-Strike Cap -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.018"/>
      <geometry>
        <cylinder length="0.016" radius="0.018"/>
      </geometry>
      <material name="emergency_red">
        <color rgba="0.90 0.10 0.10 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry>
        <cylinder length="0.030" radius="0.020"/>
      </geometry>
    </collision>
  </link>
  <joint name="estop_button_joint" type="fixed">
    <parent link="top_deck_link"/>
    <child link="estop_button_link"/>
    <origin rpy="0 0 0" xyz="-0.22 0.11 0.015"/>
  </joint>
  <!-- 9-DOF Industrial IMU (Inside Lower Chassis Core) -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>
  <!-- GNSS / GPS Antenna (Mounted on Mast Bracket) -->
  <link name="gps_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <geometry>
        <cylinder length="0.02" radius="0.025"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1"/>
      </material>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="gps_link"/>
    <origin rpy="0 0 0" xyz="-0.04 0.0 0.35"/>
  </joint>
  <!-- Arm Mount Plate -->
  <link name="piper_mount">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="piper_mount_joint" type="fixed">
    <parent link="manipulator_mount"/>
    <child link="piper_mount"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Link 1 (Base Yaw) -->
  <link name="piper_link1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="piper_joint1" type="revolute">
    <parent link="piper_mount"/>
    <child link="piper_link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.01"/>
    <axis xyz="0 0 1"/>
    <limit effort="100.0" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>
  <!-- Link 2 (Shoulder Pitch) -->
  <link name="piper_link2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.15"/>
      <geometry>
        <box size="0.06 0.06 0.3"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.15"/>
      <geometry>
        <box size="0.06 0.06 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="piper_joint2" type="revolute">
    <parent link="piper_link1"/>
    <child link="piper_link2"/>
    <origin rpy="0 0 0" xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit effort="100.0" lower="-1.57" upper="1.57" velocity="1.0"/>
  </joint>
  <!-- Link 3 (Elbow Pitch) -->
  <link name="piper_link3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.1"/>
      <geometry>
        <box size="0.05 0.05 0.2"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.1"/>
      <geometry>
        <box size="0.05 0.05 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="piper_joint3" type="revolute">
    <parent link="piper_link2"/>
    <child link="piper_link3"/>
    <origin rpy="0 0 0" xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>
    <limit effort="80.0" lower="-2.0" upper="2.0" velocity="1.5"/>
  </joint>
  <!-- Link 4 (Wrist Roll) -->
  <link name="piper_link4">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <geometry>
        <cylinder length="0.1" radius="0.03"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
      <geometry>
        <cylinder length="0.1" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  <joint name="piper_joint4" type="revolute">
    <parent link="piper_link3"/>
    <child link="piper_link4"/>
    <origin rpy="0 0 0" xyz="0 0 0.2"/>
    <axis xyz="0 0 1"/>
    <limit effort="40.0" lower="-3.14" upper="3.14" velocity="2.0"/>
  </joint>
  <!-- Link 5 (Wrist Pitch) -->
  <link name="piper_link5">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <box size="0.04 0.04 0.08"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <box size="0.04 0.04 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="piper_joint5" type="revolute">
    <parent link="piper_link4"/>
    <child link="piper_link5"/>
    <origin rpy="0 0 0" xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit effort="40.0" lower="-1.57" upper="1.57" velocity="2.0"/>
  </joint>
  <!-- Link 6 (Wrist Yaw / End Effector Mount) -->
  <link name="piper_link6">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <cylinder length="0.04" radius="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <cylinder length="0.04" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="piper_joint6" type="revolute">
    <parent link="piper_link5"/>
    <child link="piper_link6"/>
    <origin rpy="0 0 0" xyz="0 0 0.08"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" lower="-3.14" upper="3.14" velocity="2.0"/>
  </joint>
  <!-- Gripper Base -->
  <link name="piper_gripper_base">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <box size="0.1 0.03 0.04"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <box size="0.1 0.03 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="piper_gripper_joint" type="fixed">
    <parent link="piper_link6"/>
    <child link="piper_gripper_base"/>
    <origin rpy="0 0 0" xyz="0 0 0.04"/>
  </joint>
  <!-- Gripper Left Finger -->
  <link name="piper_finger_left">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <box size="0.01 0.02 0.08"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <box size="0.01 0.02 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="piper_finger_left_joint" type="prismatic">
    <parent link="piper_gripper_base"/>
    <child link="piper_finger_left"/>
    <origin rpy="0 0 0" xyz="0.04 0 0.04"/>
    <axis xyz="-1 0 0"/>
    <limit effort="100.0" lower="-0.005" upper="0.035" velocity="0.5"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>
  <!-- Gripper Right Finger -->
  <link name="piper_finger_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <box size="0.01 0.02 0.08"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <box size="0.01 0.02 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="piper_finger_right_joint" type="prismatic">
    <parent link="piper_gripper_base"/>
    <child link="piper_finger_right"/>
    <origin rpy="0 0 0" xyz="-0.04 0 0.04"/>
    <axis xyz="1 0 0"/>
    <limit effort="100.0" lower="-0.005" upper="0.035" velocity="0.5"/>
    <dynamics damping="0.5" friction="0.0"/>
    <mimic joint="piper_finger_left_joint" multiplier="1.0"/>
  </joint>
  <!-- End Effector Optical Frame (for Grasping calculations) -->
  <link name="piper_end_effector"/>
  <joint name="piper_ee_joint" type="fixed">
    <parent link="piper_gripper_base"/>
    <child link="piper_end_effector"/>
    <origin rpy="0 0 0" xyz="0 0 0.08"/>
  </joint>
</robot>
