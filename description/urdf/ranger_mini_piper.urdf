<!-- =================================================================================== -->
<robot name="ranger_mini">
  <!-- ========================================== -->
  <!-- ROS2 CONTROL HARDWARE INTERFACES           -->
  <!-- ========================================== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- Front Left Steering -->
    <joint name="fl_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Front Right Steering -->
    <joint name="fr_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Rear Left Steering -->
    <joint name="rl_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Rear Right Steering -->
    <joint name="rr_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Front Left Wheel -->
    <joint name="fl_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Front Right Wheel -->
    <joint name="fr_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Rear Left Wheel -->
    <joint name="rl_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Rear Right Wheel -->
    <joint name="rr_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Piper Gripper -->
    <joint name="piper_finger_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="position_proportional_gain">10.0</param>
    </joint>
  </ros2_control>
  <!-- ========================================== -->
  <!-- IGNITION GAZEBO (FORTRESS) PLUGINS         -->
  <!-- ========================================== -->
  <!-- Joint State Publisher for Gazebo Sim (Harmonic) -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/yash/ranger_mini_lyrical_2604_ws/install/ranger_control/share/ranger_control/config/controller.yaml</parameters>
      <position_proportional_gain>0.5</position_proportional_gain>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>piper_link6</parent_link>
      <child_model>target_cube_red</child_model>
      <child_link>cube_link</child_link>
      <attach_topic>/model/ranger_mini/attach</attach_topic>
      <detach_topic>/model/ranger_mini/detach</detach_topic>
      <output_topic>/model/ranger_mini/detachable_joint/state</output_topic>
    </plugin>
  </gazebo>
  <!-- Piper Left Finger Surface and Contact Properties -->
  <gazebo reference="piper_finger_left">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <sensor name="left_finger_contact" type="contact">
      <contact>
        <collision>piper_finger_left_collision</collision>
      </contact>
      <update_rate>50</update_rate>
      <topic>/piper/gripper_contact_left</topic>
    </sensor>
  </gazebo>
  <!-- Piper Right Finger Surface and Contact Properties -->
  <gazebo reference="piper_finger_right">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <sensor name="right_finger_contact" type="contact">
      <contact>
        <collision>piper_finger_right_collision</collision>
      </contact>
      <update_rate>50</update_rate>
      <topic>/piper/gripper_contact_right</topic>
    </sensor>
  </gazebo>
  <!-- Lidar Plugin -->
  <gazebo reference="lidar_link">
    <sensor name="livox_mid360" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>lidar/points</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1000</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.12217</min_angle>
            <max_angle>0.92502</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  <!-- Ground Truth Odometry via OdometryPublisher in Gazebo Sim -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/odometry</odom_topic>
      <dimensions>3</dimensions>
      <tf_topic>/model/ranger_mini/tf</tf_topic>
    </plugin>
  </gazebo>
  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- GPS / NavSat Sensor -->
  <gazebo reference="gps_link">
    <sensor name="navsat_sensor" type="navsat">
      <always_on>1</always_on>
      <update_rate>5</update_rate>
      <topic>gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- RealSense RGB-D Camera -->
  <gazebo reference="camera_link">
    <sensor name="realsense_d455" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.50098</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <optical_frame_id>camera_optical_link</optical_frame_id>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>camera</topic>
    </sensor>
  </gazebo>
  <!-- Base Footprint: Projected center on the ground (inertial preserves rigid link in SDFormat) -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
